<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <TargetFramework>net6.0-windows</TargetFramework>
    <SupportedOSPlatformVersion>6.1</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>HSHGamepad</AssemblyName>
    <Version>1.0.5</Version>
    <Product>HSH Gamepad</Product>
    <AssemblyTitle>HSH Gamepad</AssemblyTitle>
    <RootNamespace>GamepadServer</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Authors>@HSHGamepad</Authors>
    <Company>@HSHGamepad</Company>
    <Copyright>Telegram: @HSHGamepad</Copyright>

    <Arch Condition="'$(Arch)' == ''">x64</Arch>
    <RuntimeIdentifier>win-$(Arch)</RuntimeIdentifier>
    <PlatformTarget>$(Arch)</PlatformTarget>
    <PublishDir>publish\$(Arch)\</PublishDir>

    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <NoWarn>$(NoWarn);NETSDK1138</NoWarn>
    <DefaultItemExcludes>$(DefaultItemExcludes);publish/**;dist/**;installer/**;redist/**;net48/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.DXGI" Version="4.2.0" />
    <PackageReference Include="SharpDX.Direct3D11" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="index.html" />
    <None Remove="index.html" />
    <EmbeddedResource Include="index.html" />
    <Content Remove="lang\*.json" />
    <None Remove="lang\*.json" />
    <EmbeddedResource Include="lang\*.json" LogicalName="lang.default.%(Filename)%(Extension)" />
    <None Remove="icon.ico" />
    <EmbeddedResource Include="icon.ico" />
    <None Remove="exit-light.ico" />
    <None Remove="exit-dark.ico" />
    <EmbeddedResource Include="exit-light.ico" />
    <EmbeddedResource Include="exit-dark.ico" />
    <None Remove="icons\telegram.png" />
    <None Remove="icons\github.png" />
    <EmbeddedResource Include="icons\telegram.png" />
    <EmbeddedResource Include="icons\github.png" />
  </ItemGroup>
</Project>
